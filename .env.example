# Required: create a free key at https://twelvedata.com/
TWELVEDATA_API_KEY=put-your-key-here

# Usually leave this unchanged.
TWELVEDATA_BASE_URL=https://api.twelvedata.com

# Display target options:
# - auto: prefer display 4 if present, otherwise the last non-primary display, otherwise primary
# - primary: use the primary display
# - DISPLAY4 or \\.\DISPLAY4: use Windows display number 4
# - index:4: use the 4th display in Electron's display list
# - label:Waveshare: use a display whose label/name contains "Waveshare"
# - id:123456: use an Electron display id
TARGET_DISPLAY=auto

# Refresh interval in seconds. 600 seconds is about 432 requests/day for 3 assets.
REFRESH_SECONDS=600
